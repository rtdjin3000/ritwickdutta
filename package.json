    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "astro": "6.4.8",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "sharp": "0.34.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "unifont": "0.7.4"
  }
}
