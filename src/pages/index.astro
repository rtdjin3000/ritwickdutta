---
import Layout from "../layouts/Layout.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import { profile, projects, career, leadership } from "../data/portfolio";
import { featuredArticles, articles } from "../data/articles";
import { projectFilters, matchesProject } from "../lib/filters";
const base = import.meta.env.BASE_URL;
---

<Layout pageType="ProfilePage">
  <section class="hero container" id="top" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span>APPLIED AI. CUSTOMER SOLUTIONS. LEADERSHIP.</p>
      <h1 id="hero-title">AI leadership.<br /><em>Real-world impact.</em></h1>
      <p class="hero-intro">I'm Ritwick, an Applied AI Architect at <strong>Microsoft</strong>. I connect business ambition, technical depth, and people to help organizations put AI to work.</p>
      <p class="hero-detail">From enterprise GenAI and agentic systems to the teams and platforms behind them &mdash; grounded in 15+ years across AI, cloud, and data.</p>
      <div class="hero-actions">
        <a class="button button-dark" href="#writing">Read my articles <span aria-hidden="true">&darr;</span></a>
        <a class="text-link" href="#work">Explore my work<span aria-hidden="true">&rarr;</span></a>
      </div>
      <p class="hero-location"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15.5 8c0 4-5.5 9-5.5 9S4.5 12 4.5 8a5.5 5.5 0 1 1 11 0Z" /><circle cx="10" cy="8" r="1.8" /></svg>Toronto, Canada <span aria-hidden="true">&middot;</span> A global perspective</p>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <span class="hero-visual-kicker">STRATEGY MEETS SYSTEMS</span>
      <svg class="hero-orbit" viewBox="0 0 400 380">
        <circle class="orbit-wash" cx="204" cy="187" r="142" />
        <circle class="orbit-line" cx="204" cy="187" r="143" />
        <circle class="orbit-inner" cx="204" cy="187" r="106" />
        <path class="orbit-connector" d="m89 116 115 71 113-57M204 187l52 128" />
        <circle class="orbit-dot light" cx="89" cy="116" r="13" />
        <circle class="orbit-dot orange" cx="317" cy="130" r="17" />
        <circle class="orbit-dot green" cx="256" cy="315" r="12" />
        <rect class="orbit-hub" x="139" y="141" width="130" height="94" rx="23" />
        <path class="hub-spark" d="M204 158v19m0 22v19m-30-30h19m22 0h19m-51-21 13 13m16 16 13 13m-42 0 13-13m16-16 13-13" />
        <rect class="orbit-label" x="20" y="58" width="138" height="35" rx="8" /><text x="89" y="80">Customer context</text>
        <rect class="orbit-label" x="244" y="82" width="134" height="35" rx="8" /><text x="311" y="104">Technical depth</text>
        <rect class="orbit-label" x="43" y="278" width="142" height="35" rx="8" /><text x="114" y="300">Responsible adoption</text>
        <circle class="orbit-small" cx="54" cy="226" r="4" /><circle class="orbit-small" cx="265" cy="45" r="4" /><circle class="orbit-small" cx="346" cy="265" r="5" />
      </svg>
      <div class="hero-visual-note"><span class="small-spark" aria-hidden="true">+</span><p>Good AI is more than a model.<br /><strong>It's a capability people can use.</strong></p></div>
    </div>
  </section>

  <div class="container proof-strip" role="region" aria-label="Experience at a glance">
    <div class="proof-item"><strong>15<span>+</span></strong><p>years across<br />AI, cloud & data</p></div>
    <div class="proof-item"><strong>{articles.length}</strong><p>published articles<br />on AI & leadership</p></div>
    <div class="proof-item"><strong>{String(projects.length).padStart(2, "0")}</strong><p>selected public<br />projects & workshops</p></div>
    <div class="proof-companies"><span>EXPERIENCE ACROSS</span><p>Microsoft <i>/</i> TELUS <i>/</i> Bell <i>/</i> Rogers</p></div>
  </div>

  <section class="section container" id="writing" aria-labelledby="writing-title">
    <div class="section-heading">
      <div><p class="eyebrow section-number">01 / ARTICLES & PERSPECTIVE</p><h2 id="writing-title">Thinking in public.<br /><em>Learning in the open.</em></h2></div>
      <p class="section-lead">Perspectives on enterprise AI, agentic systems, and the human side of leadership. Published on LinkedIn, collected here for easier discovery.</p>
    </div>
    <div class="featured-writing">
      {featuredArticles.map((article, index) => (
        <article class:list={["writing-feature", { "writing-feature-primary": index === 0 }]}>
          <div class="writing-feature-meta"><span>ARTICLE</span><span>{article.readTime}</span></div>
          <h3><a href={article.url} target="_blank" rel="noopener noreferrer">{article.title}<span class="sr-only"> (opens in a new tab)</span></a></h3>
          <p>{article.summary}</p>
          <a class="text-link" href={article.url} target="_blank" rel="noopener noreferrer">Read on LinkedIn<span class="sr-only">: {article.title} (opens in a new tab)</span><span aria-hidden="true">&nearr;</span></a>
        </article>
      ))}
    </div>
    <div class="section-tail"><p>{articles.length} published articles. Original posts are a supporting archive.</p><a class="text-link" href={`${base}writing/`}>Read all articles<span aria-hidden="true">&rarr;</span></a></div>
  </section>

  <section class="section container" id="work" aria-labelledby="work-title">
    <div class="section-heading">
      <div><p class="eyebrow section-number">02 / SELECTED WORK</p><h2 id="work-title">Proof, not just<br /><em>a point of view.</em></h2></div>
      <p class="section-lead">Public workshops, demos, and applied experiments. A closer look at how I connect AI capability with the realities of building, operating, and adopting it.</p>
    </div>
    <div class="work-toolbar">
      <div class="filter-group" data-project-filters hidden role="group" aria-label="Filter projects">
        {projectFilters.map((filter) => (
          <button class="filter-button" data-project-filter={filter.id} aria-pressed={filter.id === "all" ? "true" : "false"} aria-controls="project-grid">
            {filter.label}<span>{projects.filter((project) => matchesProject(project.categories, filter.id)).length}</span>
          </button>
        ))}
      </div>
      <p class="result-count" data-project-count role="status" aria-live="polite">Showing all {projects.length} projects</p>
    </div>
    <div class="project-grid" id="project-grid">
      {projects.map((project, index) => (
        <article class="project-card" data-project-card data-categories={project.categories.join(" ")}>
          <a class="project-image-link" href={`${base}work/${project.slug}/`} tabindex="-1" aria-hidden="true"><ProjectVisual variant={project.visual} /></a>
          <div class="project-card-body">
            <div class="project-meta"><span class="type-badge">{project.type}</span><span>{project.year}</span><span class="project-index">{String(index + 1).padStart(2, "0")}</span></div>
            <h3><a href={`${base}work/${project.slug}/`}>{project.title}</a></h3>
            <p>{project.description}</p>
            <ul class="tags" aria-label="Technologies and themes">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
            <div class="project-links">
              <a href={`${base}work/${project.slug}/`}>Project brief<span class="sr-only">: {project.subtitle}</span><span aria-hidden="true">&rarr;</span></a>
              <a href={project.repository} target="_blank" rel="noopener noreferrer">Repository<span class="sr-only">: {project.subtitle} (opens in a new tab)</span><span aria-hidden="true">&nearr;</span></a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="section-tail"><p>More experiments. Two GitHub homes.</p><div>{profile.github.map((account) => <a class="text-link" href={account.url} target="_blank" rel="noopener noreferrer">{account.username}<span aria-hidden="true">&nearr;</span><span class="sr-only"> (opens in a new tab)</span></a>)}</div></div>
  </section>

  <section class="leadership-section" id="leadership" aria-labelledby="leadership-title">
    <div class="container section">
      <div class="section-heading">
        <div><p class="eyebrow section-number">03 / LEADERSHIP IN PRACTICE</p><h2 id="leadership-title">Lead the direction.<br /><em>Understand the details.</em></h2></div>
        <p class="section-lead">I work at the intersection of customer needs, technical decisions, and organizational capability. The aim is not simply to demonstrate AI &mdash; it's to help teams move forward with confidence.</p>
      </div>
      <div class="leadership-principles">
        {leadership.map((principle) => (
          <article><span class="principle-number">{principle.number}</span><h3>{principle.title}</h3><p>{principle.text}</p><small>{principle.evidence}</small></article>
        ))}
      </div>
      <div class="career-layout">
        <div class="career-timeline">
          <p class="eyebrow">A CAREER BUILT ON DELIVERY</p>
          {career.map((role) => (
            <article class:list={["career-item", { "is-current": role.current }]}>
              <div class="career-company"><h3>{role.organization}</h3><p>{role.dates}</p></div>
              <div class="career-description"><h4>{role.role}{role.current && <span class="current-label">CURRENT</span>}</h4><p>{role.description}</p></div>
            </article>
          ))}
        </div>
        <aside class="teaching-card">
          <span class="teaching-symbol" aria-hidden="true">*</span><p class="eyebrow">SHARING THE CAPABILITY</p><h3>Build.<br />Lead.<br /><em>Teach.</em></h3>
          <p>Good technical leadership leaves people more capable than it found them.</p>
          <div><h4>Humber College</h4><p>Course Developer, AI with Machine Learning<br /><span>2023 - Present</span></p></div>
          <div><h4>Durham College</h4><p>Professor, Emerging Technologies<br /><span>2021 - 2025</span></p></div>
        </aside>
      </div>
    </div>
  </section>

  <section class="about-section container" id="about" aria-labelledby="about-title">
    <div class="about-heading"><p class="eyebrow section-number">04 / A LITTLE ABOUT ME</p><h2 id="about-title">A builder's mindset.<br /><em>A leader's perspective.</em></h2><span class="about-monogram" aria-hidden="true">rd<span>+</span></span></div>
    <div class="about-copy">
      <p class="about-intro">My work connects the rigor of architecture with the realities of people, products, and adoption.</p>
      <p>I've built AI assistants, led enterprise AI and data portfolios, and advised regulated organizations on the path toward production-ready GenAI. Today, I bring that experience to customer architecture at Microsoft.</p>
      <p>My background also includes quantitative investment management, analytics, and teaching. That mix keeps me interested in both questions: <strong>can we build it well, and will it actually help?</strong></p>
      <div class="expertise-list">
        <div><h3>AI systems</h3><p>GenAI & agents / RAG / Evaluation & safety / MLOps</p></div>
        <div><h3>Platforms</h3><p>Azure / Google Cloud / Kubernetes / Enterprise data</p></div>
        <div><h3>Leadership</h3><p>Customer solutions / AI strategy / Technical enablement</p></div>
      </div>
      <p class="education-note">Master in Quantitative Investment Management, University of New Brunswick<br />MBA in Strategy, Amity Business School</p>
    </div>
  </section>

  <section class="contact-section" id="connect" aria-labelledby="connect-title">
    <div class="container contact-inner">
      <div><p class="eyebrow">LET'S CONNECT</p><h2 id="connect-title">Let's make<br /><em>AI useful.</em></h2><p>AI strategy. Customer solutions. Technical leadership.<br />Meaningful conversations start with a real problem.</p></div>
      <div class="contact-actions">
        <a class="button button-light" href={`mailto:${profile.email}?subject=Applied%20AI%20%26%20customer%20solutions`}>Start a conversation<span aria-hidden="true">&nearr;</span></a>
        <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="contact-secondary"><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<span aria-hidden="true">&nearr;</span><span class="sr-only"> (opens in a new tab)</span></a><button data-copy-email data-email={profile.email} hidden>Copy email</button></div>
        <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
        <p class="contact-location">Based in Toronto. Conversations across North America and beyond.</p>
      </div>
    </div>
  </section>

  <script>
    import { isProjectFilter, matchesProject, resultLabel } from "../lib/filters";

    const filters = document.querySelector<HTMLElement>("[data-project-filters]");
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-project-card]"));
    const count = document.querySelector<HTMLElement>("[data-project-count]");
    if (!filters || !count) throw new Error("Project filtering controls are missing.");
    filters.hidden = false;
    filters.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLButtonElement>("[data-project-filter]");
      if (!button) return;
      const filter = button.dataset.projectFilter;
      if (!filter || !isProjectFilter(filter)) throw new Error("Unsupported project filter.");
      filters.querySelectorAll<HTMLButtonElement>("button").forEach((control) => {
        control.setAttribute("aria-pressed", String(control === button));
      });
      let visible = 0;
      cards.forEach((card) => {
        const matches = matchesProject((card.dataset.categories || "").split(" "), filter);
        card.hidden = !matches;
        if (matches) visible++;
      });
      count.textContent = `Showing ${resultLabel(visible, "project")}`;
    });

    const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");
    const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");
    if (!copyButton || !copyStatus) throw new Error("Email copy controls are missing.");
    copyButton.hidden = false;
    copyButton.addEventListener("click", async () => {
      const email = copyButton.dataset.email;
      if (!email) throw new Error("The contact email is missing.");
      if (!navigator.clipboard) {
        copyStatus.textContent = "Clipboard is unavailable. Please use the email link or select the address.";
        return;
      }
      try {
        await navigator.clipboard.writeText(email);
        copyStatus.textContent = "Email address copied.";
      } catch (error) {
        console.error("Could not copy the contact email.", error);
        copyStatus.textContent = "Copy failed. Please use the email link or select the address.";
      }
    });
  </script>
</Layout>
