---
import { getImage } from "astro:assets";
import socialCard from "../assets/social-card.svg";
import { profile } from "../data/portfolio";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pageType?: "ProfilePage" | "CollectionPage" | "WebPage";
  noIndex?: boolean;
}

const {
  title = "Ritwick Dutta | AI Leadership & Customer Solutions",
  description = profile.description,
  pageType = "WebPage",
  noIndex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
if (!Astro.site) throw new Error("The public site URL must be configured.");
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const personId = new URL(`${base}#ritwick-dutta`, Astro.site).href;
const socialImage = await getImage({ src: socialCard, format: "png", width: 1200, height: 630 });
const socialImageUrl = new URL(socialImage.src, Astro.site).href;
const person = {
  "@type": "Person",
  "@id": personId,
  name: profile.name,
  jobTitle: profile.title,
  worksFor: { "@type": "Organization", name: profile.organization },
  homeLocation: { "@type": "Place", name: profile.location },
  sameAs: [profile.linkedin, ...profile.github.map((account) => account.url)],
  knowsAbout: ["Applied AI", "Generative AI", "Agentic systems", "AI leadership", "Customer solutions", "MLOps", "Responsible AI"],
};
const structuredData = {
  "@context": "https://schema.org",
  "@type": pageType,
  name: title,
  description,
  url: canonical,
  ...(pageType === "ProfilePage" ? { mainEntity: person } : { author: person }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#f6f6ef" />
    <meta name="robots" content={import.meta.env.DEV || noIndex ? "noindex, nofollow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ritwick Dutta - AI leadership and real-world delivery" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={base} aria-label="Ritwick Dutta - home">
          <span class="brand-mark" aria-hidden="true">rd<span></span></span>
          <span>Ritwick Dutta<span class="brand-caption">APPLIED AI & CUSTOMER SOLUTIONS</span></span>
        </a>
        <button class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="site-navigation" hidden>
          <span data-menu-label>Menu</span><span class="menu-lines" aria-hidden="true"></span>
        </button>
        <nav class="site-nav" id="site-navigation" aria-label="Main navigation">
          <a href={`${base}writing/`}>Writing</a>
          <a href={`${base}#work`}>Work</a>
          <a href={`${base}#leadership`}>Leadership</a>
          <a href={`${base}#about`}>About</a>
          <a class="nav-connect" href={`${base}#connect`}>Let's connect <span aria-hidden="true">&nearr;</span></a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-top">
        <a class="footer-name" href={base}>Ritwick Dutta<span>AI leadership. Real-world delivery.</span></a>
        <nav class="footer-links" aria-label="Social profiles">
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span class="sr-only">(opens in a new tab)</span><span aria-hidden="true">&nearr;</span></a>
          {profile.github.map((account) => (
            <a href={account.url} target="_blank" rel="noopener noreferrer">GitHub / {account.username}<span class="sr-only"> (opens in a new tab)</span><span aria-hidden="true">&nearr;</span></a>
          ))}
        </nav>
      </div>
      <div class="container footer-bottom">
        <p>&copy; {new Date().getFullYear()} Ritwick Dutta. Built with intention.</p>
        <p>Personal portfolio. Views are my own; no employer endorsement.</p>
        <a href={`${base}#top`}>Back to top <span aria-hidden="true">&uarr;</span></a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
      const navigation = document.querySelector<HTMLElement>("#site-navigation");
      const label = document.querySelector<HTMLElement>("[data-menu-label]");
      if (!toggle || !navigation || !label) throw new Error("Navigation controls are missing.");

      function setMenu(open: boolean) {
        if (!toggle || !navigation || !label) throw new Error("Navigation controls are missing.");
        toggle.setAttribute("aria-expanded", String(open));
        label.textContent = open ? "Close" : "Menu";
        navigation.classList.toggle("is-open", open);
      }

      toggle.hidden = false;
      navigation.classList.add("is-enhanced");
      toggle.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
      navigation.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("a")) setMenu(false);
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
          setMenu(false);
          toggle.focus();
        }
      });
      window.matchMedia("(min-width: 900px)").addEventListener("change", () => setMenu(false));
    </script>
  </body>
</html>
